{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stone.local/s/policy/lineup.schema.json",
  "title": "s Lineup Policy",
  "description": "Declarative tool lineup promoted into /s via CHALLENGE_POLICY + FIDO2 SSHSIG COMMIT_POLICY.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_revision", "description", "entries"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["install_rel_path", "bundle_name", "version", "sha256", "cdhash", "team_id"],
        "properties": {
          "install_rel_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          },
          "bundle_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cdhash": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "team_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4,16}$"
          }
        }
      }
    }
  }
}
